# ------------------------------------------------------------------
# Backend environment template
# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored — never commit it. `.env.example` is safe.
# Loaded automatically at startup via dotenv (see src/main.ts).
# ------------------------------------------------------------------

# --- Database (Neon PostgreSQL, read by Prisma) ---
# Neon Dashboard → Connect → pooled connection string.
# Format:
#   postgresql://USER:PASSWORD@ep-xxxxx.<region>.aws.neon.tech/<db>?sslmode=require
# If empty or unreachable, the app falls back to in-memory seed data (see spec > Important Failure Modes).
DATABASE_URL=

# --- HTTP server ---
# Port the NestJS server listens on (default: 3001)
PORT=3001

# --- CORS ---
# Exact frontend origin allowed to call the API. No trailing slash.
# Dev default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Authentication / session (active from the auth slice) ---
# Long random string used to sign session tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Session lifetime in hours (spec: 2-hour session lifecycle)
SESSION_TTL_HOURS=2
