# ------------------------------------------------------------------
# Backend environment template
# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored — never commit it. `.env.example` is safe.
# Loaded automatically at startup via dotenv (see src/main.ts).
# ------------------------------------------------------------------

# --- Database (Neon PostgreSQL, read by Prisma) ---
# Neon Dashboard → Connect → pooled connection string.
# Format:
#   postgresql://USER:PASSWORD@ep-xxxxx.<region>.aws.neon.tech/<db>?sslmode=require
# If empty or unreachable, the app falls back to in-memory seed data (see spec > Important Failure Modes).
DATABASE_URL=

# --- HTTP server ---
# Port the NestJS server listens on (default: 3001)
PORT=3001

# --- CORS ---
# Exact frontend origin allowed to call the API. No trailing slash.
# Dev default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Library seeding ---
# Set to false to boot with an empty library (to see the empty-state /
# popular-games quick-add flow). Anything else (or unset) seeds the demo games.
SEED_ON_BOOT=true

# --- Authentication / Better Auth (active from the auth slice) ---
# Secret used by Better Auth to sign session cookies. Long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (AUTH_SECRET is accepted as a fallback name.)
BETTER_AUTH_SECRET=
# Public base URL of this backend (Better Auth constructs callback links from it).
BETTER_AUTH_URL=http://localhost:3001
# Session lifetime in hours (legacy setting; Better Auth manages its own expiry)
SESSION_TTL_HOURS=2
