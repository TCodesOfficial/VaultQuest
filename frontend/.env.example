# ------------------------------------------------------------------
# Frontend environment template (Vite)
# Copy this file to `.env` in the same folder and fill in values.
# `.env` is gitignored — never commit it. `.env.example` is safe.
# Vite only exposes variables prefixed with VITE_ to browser code.
# Restart `npm run dev` after changing values.
# ------------------------------------------------------------------

# --- API ---
# Base URL of the NestJS backend, no trailing slash.
# Dev default: http://localhost:3001/api/v1
VITE_API_BASE_URL=http://localhost:3001/api/v1

# --- Real-time (used from the WebSocket slice) ---
# Socket.IO server URL (same origin as the API).
VITE_WS_URL=http://localhost:3001
